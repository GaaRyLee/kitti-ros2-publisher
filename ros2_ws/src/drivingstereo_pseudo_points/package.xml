<?xml version="1.0"?>
<package format="3">
  <name>drivingstereo_pseudo_points</name>
  <version>0.1.0</version>
  <description>Generate filtered pseudo point clouds from paired DrivingStereo ROS images.</description>
  <maintainer email="maintainer@example.com">DrivingStereo pseudo-points</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>kitti_image_receiver</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
