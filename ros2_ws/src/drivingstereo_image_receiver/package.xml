<?xml version="1.0"?>
<package format="3">
  <name>drivingstereo_image_receiver</name>
  <version>0.1.0</version>
  <description>Receive paired DrivingStereo ROS images and save their pixel values as text.</description>
  <maintainer email="maintainer@example.com">DrivingStereo receiver</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
